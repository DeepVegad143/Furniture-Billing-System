{
  "name": "deep-furniture",
  "version": "1.0.0",
  "description": "Deep Furniture — Billing & Rate-Quote Full-Stack Web App",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client\"",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
